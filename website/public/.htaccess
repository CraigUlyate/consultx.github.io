# ConsultX static export — keep HTML fresh; hashed assets can cache long-term.
# Explicitly force UTF-8 so punctuation such as em dashes and curly apostrophes
# is not decoded as Windows-1252 by the hosting layer.
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .htm .css .js .json .svg .txt .xml

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=0, must-revalidate"

  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|png|jpe?g|gif|svg|webp|ico|map)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
